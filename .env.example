# Careloop Environment Variables Configuration Template
# NOTE: Never commit production credentials or private keys to git.

# -------------------------------------------------------------
# 1. FRONTEND CLIENT CONFIGURATION (Firebase Spark Free Tier)
# -------------------------------------------------------------
# These variables configure Google Firebase Authentication and Cloud Firestore for the Vite SPA.
# If omitted, the web application runs in offline persistent Demo Sandbox mode.
VITE_FIREBASE_API_KEY=AIzaSyExamplePlaceholderKey123456789
VITE_FIREBASE_AUTH_DOMAIN=careloop-health.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=careloop-health
VITE_FIREBASE_STORAGE_BUCKET=careloop-health.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# -------------------------------------------------------------
# 2. WHATSAPP SERVER / META CLOUD API (Node.js Webhook Prototype)
# -------------------------------------------------------------
# Port for the Node.js webhook server (defaults to 4000)
PORT=4000
NODE_ENV=development

# Webhook verification secret chosen when configuring Meta App Webhook
# In production, must be set to a strong secret. No default token is permitted in production.
META_VERIFY_TOKEN=your_secure_meta_webhook_verify_token_here

# Meta App Secret used to compute and verify incoming X-Hub-Signature-256 HMAC SHA-256 headers
META_APP_SECRET=your_meta_app_secret_hex_here

# Meta Cloud API System User access token (Required only if sending real WhatsApp messages)
META_API_TOKEN=your_meta_system_user_access_token_here

# Meta WhatsApp Phone Number ID (Found in WhatsApp > API Setup on Meta Developer Portal)
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
