rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly authorized
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isWorkspacePractitioner(workspaceId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid;
    }

    function isWorkspaceParticipant(workspaceId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/participants/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/participants/$(request.auth.token.email)))
      );
    }

    // --- USERS & PRACTITIONER PROFILES ---
    match /users/{userId} {
      // User can read their own profile
      allow read: if isOwner(userId);
      // User can create their initial profile, cannot elevate role manually
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['email', 'role', 'createdAt']) &&
        (request.resource.data.role == 'practitioner' || request.resource.data.role == 'participant');
      // User can update profile fields, but cannot modify their role or workspace ownership
      allow update: if isOwner(userId) && 
        request.resource.data.role == resource.data.role;
      allow delete: if false; // Deletion handled through account closure workflows
    }

    // --- WORKSPACES ---
    match /workspaces/{workspaceId} {
      // Workspace can only be read by its practitioner owner, or an enrolled participant
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.participants[request.auth.token.email] == true ||
        isWorkspaceParticipant(workspaceId)
      );
      // Only practitioner can create a workspace that they own
      allow create: if isAuthenticated() && 
        request.resource.data.ownerUid == request.auth.uid;
      // Only practitioner owner can update workspace settings; cannot transfer ownerUid
      allow update: if isAuthenticated() && 
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isAuthenticated() && 
        resource.data.ownerUid == request.auth.uid;
    }

    // --- PARTICIPANTS IN A WORKSPACE ---
    match /workspaces/{workspaceId}/participants/{participantId} {
      // Practitioner owner has full access
      allow read, write: if isWorkspacePractitioner(workspaceId);
      
      // Participant can read their own participant record
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email ||
        resource.data.uid == request.auth.uid
      );
      
      // Participant cannot self-assign programs, change status, or elevate plans
      allow update: if false;
    }

    // --- PROGRAMS & TEMPLATES ---
    match /workspaces/{workspaceId}/programs/{programId} {
      // Practitioner owner has full create, update, delete
      allow write: if isWorkspacePractitioner(workspaceId);
      
      // Practitioner owner and enrolled workspace participants can read program tasks
      allow read: if isWorkspacePractitioner(workspaceId) || isWorkspaceParticipant(workspaceId);
    }

    // --- PROGRAM ASSIGNMENTS ---
    match /workspaces/{workspaceId}/assignments/{assignmentId} {
      // Practitioner owner can manage all assignments
      allow read, write: if isWorkspacePractitioner(workspaceId);
      
      // Participant can read only their own assignment
      allow read: if isAuthenticated() && (
        resource.data.participantEmail == request.auth.token.email ||
        resource.data.participantUid == request.auth.uid
      );
    }

    // --- TASK COMPLETIONS & CHECK-INS ---
    match /workspaces/{workspaceId}/completions/{completionId} {
      // Practitioner owner can read and review all completions
      allow read: if isWorkspacePractitioner(workspaceId);
      
      // Participant can read only their own completions within their authorized workspace
      allow read: if isWorkspaceParticipant(workspaceId) && (
        resource.data.participantEmail == request.auth.token.email ||
        resource.data.participantUid == request.auth.uid
      );
      
      // Participant can create or update daily check-ins ONLY within their enrolled workspace
      // Prevents cross-tenant writes and unassigned modifications
      allow create, update: if (isWorkspacePractitioner(workspaceId) || isWorkspaceParticipant(workspaceId)) && (
        (request.resource.data.participantEmail == request.auth.token.email ||
         request.resource.data.participantUid == request.auth.uid) ||
        isWorkspacePractitioner(workspaceId)
      ) && (
        request.resource.data.status in ['completed', 'skipped', 'pending']
      );

      // Deletions strictly restricted to practitioner owner
      allow delete: if isWorkspacePractitioner(workspaceId);
    }

    // --- SIMULATED REMINDERS ---
    match /workspaces/{workspaceId}/reminders/{reminderId} {
      // Only practitioner owner can configure or view reminder queues
      allow read, write: if isWorkspacePractitioner(workspaceId);
    }

    // --- EARLY ACCESS LEADS (Public Ingress) ---
    match /early_access_leads/{leadId} {
      // Prospective customers can submit interest safely without prior authentication
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'createdAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3;
      // Contact data is strictly protected against public reads or modification
      allow read, update, delete: if false;
    }
  }
}
